// The Gravity Report — static assets + a small API worker (votes, reading telemetry).
{
  "name": "thegravityreport",
  "main": "worker.js",
  "compatibility_date": "2026-07-10",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Social posting cron. Harmless until secrets are set: SOCIAL_DRY_RUN stays "1" (simulate only).
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": { "SOCIAL_DRY_RUN": "1", "SOCIAL_X_MONTHLY_CAP": "60" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gravity",
      "database_id": "cd6ffa0d-e407-4605-b0ef-c5584f665e2b"
    }
  ]
}
